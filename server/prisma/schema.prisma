generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // direct connection (db push / migrations)
}

enum Role {
  STUDENT
  ADMIN
}

enum RideStatus {
  OPEN       // posted, waiting for co-riders
  MATCHED    // 2+ riders, driver assigned
  COMPLETED
  CANCELLED
}

enum MemberStatus {
  JOINED
  LEFT
}

enum PaymentStatus {
  PENDING
  PAID
}

enum VehicleType {
  AUTO
  CAB
  TEMPO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  hostelBlock  String?
  roomNumber   String?
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ridesCreated Ride[]
  memberships  RideMember[]
  ratings      DriverRating[]
  messages     Message[]
  driversAdded Driver[]

  @@map("users")
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  isCampus  Boolean  @default(false)
  createdAt DateTime @default(now())

  ridesFrom Ride[] @relation("RideFrom")
  ridesTo   Ride[] @relation("RideTo")

  @@map("locations")
}

model Driver {
  id            String      @id @default(uuid())
  name          String
  phone         String      @unique
  vehicleNumber String?
  vehicleType   VehicleType @default(AUTO)
  avgRating     Float       @default(0)
  ratingCount   Int         @default(0)
  totalRides    Int         @default(0)
  isVerified    Boolean     @default(false)
  isActive      Boolean     @default(true)
  addedById     String?
  createdAt     DateTime    @default(now())

  addedBy User?          @relation(fields: [addedById], references: [id])
  rides   Ride[]
  ratings DriverRating[]

  @@map("drivers")
}

model Ride {
  id             String     @id @default(uuid())
  creatorId      String
  fromLocationId String
  toLocationId   String
  departureTime  DateTime
  maxRiders      Int        @default(3)
  status         RideStatus @default(OPEN)
  driverId       String?
  totalFare      Int?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  creator      User         @relation(fields: [creatorId], references: [id])
  fromLocation Location     @relation("RideFrom", fields: [fromLocationId], references: [id])
  toLocation   Location     @relation("RideTo", fields: [toLocationId], references: [id])
  driver       Driver?      @relation(fields: [driverId], references: [id])
  members      RideMember[]
  messages     Message[]
  ratings      DriverRating[]

  @@index([status, departureTime])
  @@index([toLocationId, departureTime])
  @@map("rides")
}

model RideMember {
  id            String        @id @default(uuid())
  rideId        String
  userId        String
  status        MemberStatus  @default(JOINED)
  fareShare     Int?
  paymentStatus PaymentStatus @default(PENDING)
  joinedAt      DateTime      @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([rideId, userId])
  @@index([userId, status])
  @@map("ride_members")
}

model DriverRating {
  id        String   @id @default(uuid())
  driverId  String
  userId    String
  rideId    String?
  rating    Int
  review    String?
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  ride   Ride?  @relation(fields: [rideId], references: [id])

  @@unique([driverId, userId])
  @@map("driver_ratings")
}

model Message {
  id        String   @id @default(uuid())
  rideId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([rideId, createdAt])
  @@map("messages")
}
